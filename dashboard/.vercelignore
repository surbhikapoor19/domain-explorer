node_modules
build
.vercel
.env*.local
.DS_Store

# IMPORTANT: do NOT ignore /public/data here. It is regenerated by the
# precompute pipeline, but Vercel must upload it as static assets.
# When .vercelignore is missing, Vercel falls back to .gitignore, which
# is why an earlier deploy went out with empty panels.
#
# /public/papers is the opposite: the PDF corpus must NEVER be published.
# This file replaces the .gitignore fallback, so a gitignored folder is still
# uploaded by a local `vercel --prod` unless it is listed here.
public/papers
